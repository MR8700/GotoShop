# ==========================================================
# GotoShop / ConversaStore - Configuration PostgreSQL & Supabase
# ==========================================================

# 1. Base de Données Supabase (Transaction Pooler port 6543 ou direct 5432)
# SUPABASE_DB_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# 2. Supabase Storage (Pour stocker photos, vidéos, fiches PDF sans limite sur Vercel)
# SUPABASE_URL=https://[PROJECT-REF].supabase.co
# SUPABASE_KEY=eyJhbGciOi... [votre anon key ou service_role key]
# SUPABASE_BUCKET=media

# 3. Alternative: PostgreSQL Local / Docker / Neon / Vercel Postgres
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=votre_mot_de_passe
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=gotoshop

# 4. URLs du serveur
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# --- Authentification sans mot de passe (Passkeys / WebAuthn) ---
PASSKEY_ENABLED=true
RECOVERY_CODES_ENABLED=true
# true tant que les commerçants (Owner) n'ont pas de Passkey ; false ensuite (POST /auth/login -> 403)
PASSWORD_AUTH_ENABLED=true
INITIAL_PHONE_VERIFICATION_REQUIRED=false
OTP_REQUIRED_FOR_NEW_DEVICE=false
OTP_REQUIRED_FOR_ACCOUNT_RECOVERY=false
# RP ID = domaine du frontend (sans https:// ni port). Origines = URL exactes du frontend.
PASSKEY_RP_ID=localhost
PASSKEY_ORIGINS=http://localhost:5173
PASSKEY_RP_NAME=GotoShop

# Connexion client par téléphone : OTP exigé si true (défaut false ; activer une fois SMS_PROVIDER configuré).
REQUIRE_LOGIN_OTP=false
# Réinitialisation du mot de passe de sécurité (commerçant) : OTP envoyé par WhatsApp.
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=
PASSWORD_RESET_OTP_TTL_MINUTES=10

# Session client : cookie HttpOnly + jeton haché en base + expiration.
CUSTOMER_SESSION_TTL_DAYS=30
CUSTOMER_COOKIE_NAME=gs_customer
# "None" (avec HTTPS) seulement si l'API est sur un autre site que le frontend ; sinon Lax.
CUSTOMER_COOKIE_SAMESITE=Lax
# true par défaut hors APP_ENV=dev (cookie envoyé seulement en HTTPS)
# CUSTOMER_COOKIE_SECURE=true
# false = le jeton de session n'est jamais renvoyé au JavaScript. true = compatibilité (ancien client, scripts).
CUSTOMER_TOKEN_IN_BODY=false
